{
  "name": "Post",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "aviso",
        "devocional",
        "evento",
        "noticia"
      ],
      "default": "noticia"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "content"
  ]
}
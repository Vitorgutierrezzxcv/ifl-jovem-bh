{
  "name": "TerminationRequest",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "member_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "cycle": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_analise",
        "concluido"
      ],
      "default": "pendente"
    },
    "response": {
      "type": "string"
    },
    "responded_by": {
      "type": "string"
    }
  },
  "required": [
    "member_name",
    "reason"
  ]
}
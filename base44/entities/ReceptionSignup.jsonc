{
  "name": "ReceptionSignup",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inscrito",
        "selecionado",
        "nao_selecionado"
      ],
      "default": "inscrito"
    },
    "event_name": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "member_id"
  ]
}
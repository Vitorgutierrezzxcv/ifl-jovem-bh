{
  "name": "ReceptionSignup",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inscrito",
        "selecionado",
        "nao_selecionado"
      ],
      "default": "inscrito"
    },
    "event_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "area": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "help_type": {
      "type": "string",
      "enum": [
        "recepcao",
        "lanche",
        "sombra"
      ],
      "default": "recepcao"
    }
  },
  "required": [
    "member_id"
  ]
}
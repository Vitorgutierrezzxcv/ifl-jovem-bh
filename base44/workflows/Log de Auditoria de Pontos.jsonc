{
  "name": "Log de Auditoria de Pontos",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"total_points\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Member"
    }
  },
  "definition": {
